{
	"name": "arctic2",
	"type": "module",
	"version": "3.7.0",
	"description": "Maintained OAuth 2.0 clients for popular providers",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"module": "dist/index.js",
	"scripts": {
		"build": "rm -rf dist && tsc",
		"check": "npm run format:check && npm run lint && npm test && npm run build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint src",
		"pack:check": "node scripts/check-package.mjs",
		"test": "vitest run"
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pablote/arctic2.git"
	},
	"homepage": "https://github.com/pablote/arctic2#readme",
	"bugs": {
		"url": "https://github.com/pablote/arctic2/issues"
	},
	"keywords": [
		"oauth",
		"oauth2",
		"openid-connect"
	],
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "24.13.3",
		"eslint": "10.9.1",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.68.0",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"jose": "6.2.10"
	}
}
